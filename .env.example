# ======================
# M-PESA / DARAJA CONFIG
# ======================

# Environment: "sandbox" or "production"
MPESA_ENV=production

# Base URL
# Sandbox: https://sandbox.safaricom.co.ke
# Production: https://api.safaricom.co.ke
MPESA_BASE_URL=https://api.safaricom.co.ke

# Your Daraja App Credentials
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Business Shortcode (Paybill / Till)
MPESA_SHORTCODE=4328771

# Lipa na M-PESA Online Passkey (must match the shortcode + environment)
MPESA_PASSKEY=your_passkey_here

# ======================
# CALLBACK URLS (must match your routes)
# ======================
MPESA_CALLBACK_URL=https://webazi-digital-solutions.onrender.com/callback/stk-callback
MPESA_VALIDATION_URL=https://webazi-digital-solutions.onrender.com/callback/validation
MPESA_CONFIRMATION_URL=https://webazi-digital-solutions.onrender.com/callback/confirmation

# ======================
# SECURITY
# ======================
# API key required by the STK routes
API_KEY=

# Optional but recommended – protect the callback from fake requests
CALLBACK_SECRET=generate_a_long_random_string_here

# ======================
# SERVER
# ======================
PORT=3000